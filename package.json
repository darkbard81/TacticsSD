{
  "name": "tacticssd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run tool --",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "npm run test:rules",
    "test:all": "npm run test:rules",
    "tool": "vite --host 0.0.0.0",
    "verify": "npm run lint && npm run build && npm run test:rules",
    "lint": "tsc --noEmit && git diff --check",
    "game": "vite --host 127.0.0.1 --port 5173 --strictPort --open /game/",
    "test:rules": "vitest run tests/game/domain.test.ts tests/game/classes.test.ts tests/game/expansion.test.ts tests/game/shop.test.ts tests/game/regression.test.ts --testNamePattern=\"^(?!generated rig)\""
  },
  "dependencies": {
    "pixi.js": "8.21.0",
    "three": "^0.186.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/three": "^0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
